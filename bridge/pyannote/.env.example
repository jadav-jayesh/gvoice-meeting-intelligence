# pyannote.ai API key (sk_...). Get one at https://dashboard.pyannote.ai
# Reuse the same key as PYANNOTE_API_KEY in the app's root .env.
PYANNOTE_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hosted API base (rarely changed).
PYANNOTE_BASE_URL=https://api.pyannote.ai/v1

# Port the bridge listens on. Must match PYANNOTE_DIARIZATION_URL in the app's
# root .env (default http://localhost:8001/diarize).
PORT=8001

# Polling tunables for the async diarization job.
PYANNOTE_POLL_INTERVAL_SECONDS=3
PYANNOTE_POLL_TIMEOUT_SECONDS=1200
PYANNOTE_HTTP_TIMEOUT_SECONDS=120
