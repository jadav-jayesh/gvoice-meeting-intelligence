NODE_ENV=development
PORT=3000
LOG_LEVEL=info

MONGODB_URI=mongodb://127.0.0.1:27017/gvoice_meeting_intelligence

# Auth (JWT in HttpOnly cookie). JWT_SECRET must be at least 32 chars.
# Generate one with:  openssl rand -hex 32
# The app REFUSES to start in production if this is still the dev default.
# COOKIE_DOMAIN: leave blank on localhost; set to your apex domain in prod (e.g. .example.com).
# WEB_ORIGIN: origin the browser loads the SPA from — used for CORS allowlist.
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
# Access token lifetime (short — refreshed transparently by the SPA via the
# refresh-token rotation flow). Accepts any "ms"-style duration: 15m, 1h, 12h.
JWT_EXPIRES_IN=15m
# Refresh token lifetime in days. User stays signed in as long as they visit
# the app at least once per window.
REFRESH_TOKEN_EXPIRES_DAYS=30
COOKIE_DOMAIN=
WEB_ORIGIN=http://localhost:5173

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
BOT_QUEUE_NAME=gvoice-meeting-bots
# Number of meetings one worker process will run in parallel. Each concurrent
# bot needs its own Chromium profile clone + its own PulseAudio sink (handled
# automatically when BROWSER_PROFILE_PER_SESSION and AUDIO_CAPTURE_PER_SESSION_SINK
# are true). Tune to host RAM/CPU — each Chromium ~300-500MB.
BOT_WORKER_CONCURRENCY=3
RUN_WORKER_IN_API=true

BROWSER_HEADLESS=false
BROWSER_WIDTH=1920
BROWSER_HEIGHT=1080
BROWSER_CHANNEL=chromium
BROWSER_COLOR_SCHEME=dark
BOT_DISPLAY_NAME=gVoice
MAX_MEETING_SECONDS=14400
JOIN_TIMEOUT_MS=180000
CAPTURE_INTERVAL_MS=2000
PARTICIPANT_PANEL_INTERVAL_MS=15000
# Auto-leave once the bot has been the only attendee for this many ms (0 disables)
BOT_AUTO_LEAVE_WHEN_ALONE_MS=20000
# Auto-leave once the meeting has been silent (no new captions) for this many
# ms after at least one caption was seen. 0 disables. Default 8 minutes.
BOT_AUTO_LEAVE_WHEN_IDLE_MS=480000
GOOGLE_USER_DATA_DIR=.data/browser-profiles/google
TEAMS_USER_DATA_DIR=.data/browser-profiles/teams
TEAMS_AUDIO_MODE=computer
TEAMS_MODE=hybrid
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_PASSWORD=
TEAMS_BOT_TENANT_ID=
TEAMS_BOT_ENABLED=false
TEAMS_GRAPH_TENANT_ID=
TEAMS_GRAPH_CLIENT_ID=
TEAMS_GRAPH_CLIENT_SECRET=
TEAMS_GRAPH_USER_ID=
TEAMS_GRAPH_TRANSCRIPT_POLL_INTERVAL_MS=30000
TEAMS_GRAPH_TRANSCRIPT_TIMEOUT_MS=300000
TEAMS_GRAPH_TRANSCRIPT_RETRY_DELAYS_MS=300000,600000,1200000,1800000,3600000
TEAMS_GRAPH_TRANSCRIPT_MAX_RETRY_ATTEMPTS=5

# --- Calendar auto-join (per-user "Connect calendar" OAuth) ---
CALENDAR_AUTO_JOIN_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
# Microsoft reuses TEAMS_GRAPH_CLIENT_ID/SECRET (add delegated Calendars.Read).
MS_OAUTH_REDIRECT_URI=http://localhost:3000/api/calendar/microsoft/callback
MS_OAUTH_TENANT=common
ENCRYPTION_KEY=change-me-openssl-rand-hex-32-min-32-chars
CALENDAR_SYNC_INTERVAL_MS=300000
CALENDAR_LOOKAHEAD_HOURS=48
CALENDAR_JOIN_LEAD_SECONDS=60

ZOOM_USER_DATA_DIR=.data/browser-profiles/zoom
# Zoom hybrid mode: cloud_transcript (Zoom Cloud Recording transcript only) | browser_live (record + transcribe locally) | hybrid (browser join + prefer Zoom cloud transcript)
ZOOM_MODE=hybrid
# Zoom Server-to-Server OAuth credentials (required when ZOOM_MODE != browser_live)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_OAUTH_BASE_URL=https://zoom.us
ZOOM_API_BASE_URL=https://api.zoom.us/v2
ZOOM_TRANSCRIPT_POLL_INTERVAL_MS=30000
ZOOM_TRANSCRIPT_TIMEOUT_MS=300000
ZOOM_TRANSCRIPT_RETRY_DELAYS_MS=300000,600000,1200000,1800000,3600000
ZOOM_TRANSCRIPT_MAX_RETRY_ATTEMPTS=5

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
AUDIO_CAPTURE_DRIVER=pulse
AUDIO_CAPTURE_SOURCE=default
AUDIO_CAPTURE_ENABLED=true
# When true (Linux/pulse only), each bot session gets its own null-sink so
# concurrent meetings don't mix audio. Falls back to AUDIO_CAPTURE_SOURCE when
# pactl is unavailable or driver != pulse.
AUDIO_CAPTURE_PER_SESSION_SINK=true
# When true, each session runs Chromium with a cloned copy of the platform's
# template profile (GOOGLE_USER_DATA_DIR / TEAMS_USER_DATA_DIR / ZOOM_USER_DATA_DIR).
# Required for N>1 concurrent meetings; persistent profiles cannot be shared
# across simultaneous Chromium launches.
BROWSER_PROFILE_PER_SESSION=true
RECORDING_DIR=.data/sessions
PRE_JOIN_TRIM_PADDING_SECONDS=1.5

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=gvoice-recordings
AZURE_STORAGE_BASE_PATH=gVoice

AZURE_OPENAI_SUMMARY_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_SUMMARY_TIMEOUT_MS=60000

SARVAM_API_KEY=
SARVAM_LANGUAGE_CODE=unknown
SARVAM_RETRY_ATTEMPTS=3
SARVAM_RETRY_DELAY_MS=2000

TRANSCRIPTION_FORCE_PROVIDER=auto
ALLOW_MOCK_AI=false
SPEAKER_MAPPING_CONFIDENCE_THRESHOLD=0.75
SPEAKER_RESOLVER_ENABLED=true
SPEAKER_RESOLVER_CONFIDENCE_THRESHOLD=0.75
ALLOW_LOW_CONFIDENCE_DOMINANCE_MAPPING=false

# ── Provider selection ───────────────────────────────────────────────────────
#   language = PRODUCTION: detect language from AUDIO, then route English ->
#              Whisper (no translation) and non-English -> Sarvam (native). Whisper
#              failure/empty after retries hands the meeting to Sarvam too.
#   sarvam   = Sarvam flow ONLY (native output, never translated)
#   whisper  = Azure Whisper + Pyannote (+ Sarvam handover on failure/empty)
#   auto     = legacy Azure/Sarvam routing (unchanged)
TRANSCRIPTION_PROVIDER=language

# Language routing knobs (used when TRANSCRIPTION_PROVIDER=language):
WHISPER_NONENGLISH_TO_SARVAM=true
WHISPER_NONENGLISH_INDIC_THRESHOLD=0.15
WHISPER_LANGUAGE_PROBE_SECONDS=90
WHISPER_SARVAM_FALLBACK=true
# Always complete real meetings even if every engine + captions are exhausted.
ALWAYS_COMPLETE_MEETINGS=true

# ── Azure Whisper (verbose_json + word timestamps) ───────────────────────────
# Leave endpoint/key/deployment blank to reuse the AZURE_OPENAI_* values above.
WHISPER_ENDPOINT=
WHISPER_API_KEY=
WHISPER_DEPLOYMENT=
WHISPER_API_VERSION=
# Keep WHISPER_PROMPT EMPTY — Indic sample sentences poison Whisper into echoing
# gibberish. Leave WHISPER_LANGUAGE EMPTY for auto-detect (never force gu).
WHISPER_PROMPT=
WHISPER_LANGUAGE=
WHISPER_TEMPERATURE=0
WHISPER_TIMEOUT_MS=120000
WHISPER_RETRY_ATTEMPTS=4
WHISPER_RETRY_DELAY_MS=2000
WHISPER_MAX_UPLOAD_BYTES=24000000
WHISPER_CHUNK_SECONDS=600
# Decode each speaker region separately so every speaker keeps their language.
WHISPER_PER_REGION_DECODE=true
WHISPER_REGION_CONCURRENCY=1

# ── Pyannote diarization bridge (bridge/pyannote) ────────────────────────────
PYANNOTE_ENABLED=true
PYANNOTE_DIARIZATION_URL=http://127.0.0.1:8001/diarize
PYANNOTE_TIMEOUT_MS=300000
PYANNOTE_RETRY_ATTEMPTS=2
PYANNOTE_RETRY_DELAY_MS=3000

# ── Translation (non-English → English transcriptText; whisper provider only) ─
TRANSLATION_ENABLED=false
TRANSLATION_TARGET_LANGUAGE=en
TRANSLATION_BATCH_SIZE=40
TRANSLATION_MAX_TOKENS=4000
